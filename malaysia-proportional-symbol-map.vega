{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 620,
  "background": "#fafafa",
  "projection": {
    "type": "mercator",
    "center": [108.25, 4.1],
    "scale": 2800
  },
  "layer": [
    {
      "data": {
        "url": "malaysia-map.json",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "filter": "datum.properties.NAME_1 !== 'Labuan' && datum.properties.NAME_1 !== 'Sabah' && datum.properties.NAME_1 !== 'Sarawak'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece9e1",
        "stroke": "#b5b5b5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "east-malaysia-map.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece9e1",
        "stroke": "#b5b5b5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "proportional-symbol-map.json"
      },
      "transform": [
        {"calculate": "datum.lon >= 109 ? datum.lon - 3.5 : datum.lon", "as": "display_lon"}
      ],
      "mark": {
        "type": "circle",
        "color": "#8B4513",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "display_lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "heritage_buildings_count",
          "type": "quantitative",
          "scale": {
            "domain": [0, 5000],
            "range": [0, 3500]
          },
          "legend": {
            "title": "Heritage buildings",
            "orient": "right",
            "symbolType": "circle",
            "symbolFillColor": "#8B4513",
            "symbolOpacity": 0.7,
            "labelFontSize": 12,
            "titleFontSize": 18,
            "format": ","
          }
        },
        "order": {"field": "heritage_buildings_count", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "estimated_count", "type": "nominal", "title": "Estimated count"}
        ]
      }
    }
  ]
}