{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 720,
  "height": 520,
  "padding": {"top": 10, "left": 20, "right": 20, "bottom": 10},
  "autosize": {"type": "pad", "contains": "padding"},
  "signals": [
    {"name": "centerX", "update": "width / 2"},
    {"name": "centerY", "update": "height / 2"},
    {"name": "maxRadius", "value": 180}
  ],
  "data": [
    {
      "name": "buildings",
      "url": "data-basic.json?community-attribution=v1",
      "format": {"type": "json"},
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["community"],
          "ops": ["count"],
          "as": ["building_count"]
        },
        {
          "type": "formula",
          "as": "order",
          "expr": "indexof(['Chinese', 'Malay', 'Indian', 'British'], datum.community)"
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "datum.order * PI / 2 - PI / 2"
        },
        {
          "type": "formula",
          "as": "radius",
          "expr": "scale('radius', datum.building_count)"
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "centerX + datum.radius * cos(datum.angle)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "centerY + datum.radius * sin(datum.angle)"
        },
        {"type": "collect", "sort": {"field": "order", "order": "ascending"}}
      ]
    },
    {
      "name": "rings",
      "values": [{"value": 5}, {"value": 10}, {"value": 15}, {"value": 20}, {"value": 25}, {"value": 30}, {"value": 35}]
    },
    {
      "name": "axes",
      "values": [
        {"community": "Chinese", "order": 0},
        {"community": "Malay", "order": 1},
        {"community": "Indian", "order": 2},
        {"community": "British", "order": 3}
      ],
      "transform": [
        {"type": "formula", "as": "angle", "expr": "datum.order * PI / 2 - PI / 2"},
        {"type": "formula", "as": "x2", "expr": "centerX + maxRadius * cos(datum.angle)"},
        {"type": "formula", "as": "y2", "expr": "centerY + maxRadius * sin(datum.angle)"},
        {"type": "formula", "as": "labelX", "expr": "centerX + (maxRadius + 28) * cos(datum.angle)"},
        {"type": "formula", "as": "labelY", "expr": "centerY + (maxRadius + 28) * sin(datum.angle)"},
        {
          "type": "lookup",
          "from": "buildings",
          "key": "community",
          "fields": ["community"],
          "values": ["building_count"],
          "as": ["building_count"]
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.community + ' (' + (datum.building_count || 0) + ')'"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "radius",
      "type": "linear",
      "domain": [0, 35],
      "range": [0, 180],
      "zero": true,
      "nice": false
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "from": {"data": "rings"},
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "shape": {"value": "circle"},
          "size": {"signal": "pow(2 * scale('radius', datum.value), 2)"},
          "fill": {"value": "#ffffff"},
          "fillOpacity": {"value": 0},
          "stroke": {"value": "#cfc8bf"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "rule",
      "from": {"data": "axes"},
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "x2": {"field": "x2"},
          "y2": {"field": "y2"},
          "stroke": {"value": "#cfc8bf"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "buildings"},
      "sort": {"field": "order"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "stroke": {"value": "#9b533d"},
          "strokeWidth": {"value": 2.5},
          "fill": {"value": "#d98b6f"},
          "fillOpacity": {"value": 0.35},
          "interpolate": {"value": "linear-closed"}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "buildings"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {"value": 100},
          "fill": {"value": "#78483a"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 1.5},
          "tooltip": {
            "signal": "{'Community association': datum.community, 'Buildings': datum.building_count}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "axes"},
      "encode": {
        "update": {
          "x": {"field": "labelX"},
          "y": {"field": "labelY"},
          "text": {"field": "label"},
          "fontSize": {"value": 14},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#333333"},
          "align": {
            "signal": "datum.order === 1 ? 'left' : datum.order === 3 ? 'right' : 'center'"
          },
          "baseline": {
            "signal": "datum.order === 0 ? 'bottom' : datum.order === 2 ? 'top' : 'middle'"
          }
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#fafafa"
  }
}
