{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 480,
  "background": "#fafafa",
  "projection": {
    "type": "mercator",
    "center": [109.5, 4.1],
    "scale": 2450
  },
  "layer": [
    {
      "data": {
        "url": "malaysia-map.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece9e1",
        "stroke": "#b5b5b5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "proportional-symbol-map.json"
      },
      "transform": [
        {
          "calculate": "datum.heritage_buildings_count < 50 ? '0–49' : datum.heritage_buildings_count < 100 ? '50–99' : datum.heritage_buildings_count < 500 ? '100–499' : datum.heritage_buildings_count <= 1000 ? '500–1,000' : '> 1,000'",
          "as": "size_class"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8B4513",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "size_class",
          "type": "ordinal",
          "legend": null,
          "scale": {
            "domain": ["0–49", "50–99", "100–499", "500–1,000", "> 1,000"],
            "range": [100, 1000, 2000, 3000, 10000]
          }
        },
        "order": {"field": "heritage_buildings_count", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "heritage_buildings_count", "type": "quantitative", "title": "Heritage buildings", "format": ","},
          {"field": "size_class", "type": "ordinal", "title": "Class"}
        ]
      }
    }
  ]
}