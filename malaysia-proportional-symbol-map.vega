{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 850,
  "height": 620,
  "background": "#fafafa",
  "projection": {
    "type": "mercator",
    "center": [108.25, 4.1],
    "scale": 2800
  },
  "layer": [
    {
      "data": {
        "url": "malaysia-map.json",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "filter": "datum.properties.NAME_1 !== 'Labuan' && datum.properties.NAME_1 !== 'Sabah' && datum.properties.NAME_1 !== 'Sarawak'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece9e1",
        "stroke": "#b5b5b5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "east-malaysia-map.json",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece9e1",
        "stroke": "#b5b5b5",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "proportional-symbol-map.json"
      },
      "transform": [
        {"calculate": "datum.lon >= 109 ? datum.lon - 3.5 : datum.lon", "as": "display_lon"},
        {
          "calculate": "datum.heritage_buildings_count <= 100 ? '1–100' : datum.heritage_buildings_count <= 250 ? '101–250' : datum.heritage_buildings_count <= 650 ? '251–650' : datum.heritage_buildings_count <= 2500 ? '651–2,500' : '2,501–5,000'",
          "as": "building_count_class"
        },
        {
          "calculate": "datum.heritage_buildings_count <= 100 ? 120 : datum.heritage_buildings_count <= 250 ? 320 : datum.heritage_buildings_count <= 650 ? 700 : datum.heritage_buildings_count <= 2500 ? 1300 : 2100",
          "as": "building_count_symbol_size"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#8B4513",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "display_lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "building_count_symbol_size",
          "type": "quantitative",
          "scale": {
            "domain": [120, 2100],
            "range": [120, 2100]
          },
          "legend": {
            "title": "Count class",
            "orient": "right",
            "symbolType": "circle",
            "symbolFillColor": "#8B4513",
            "symbolOpacity": 0.7,
            "labelFontSize": 12,
            "titleFontSize": 18,
            "values": [120, 320, 700, 1300, 2100],
            "labelExpr": "datum.value == 120 ? '1–100' : datum.value == 320 ? '101–250' : datum.value == 700 ? '251–650' : datum.value == 1300 ? '651–2,500' : '2,501–5,000'"
          }
        },
        "order": {"field": "heritage_buildings_count", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "estimated_count", "type": "nominal", "title": "Estimated count"},
          {"field": "building_count_class", "type": "nominal", "title": "Count class"}
        ]
      }
    }
  ]
}