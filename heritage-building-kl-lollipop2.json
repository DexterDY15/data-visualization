{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 360,
  "background": "#fafafa",
  "data": {
    "url": "data-basic.json?dashboard-restructure=v1",
    "format": {"type": "json"}
  },
  "transform": [
    {"filter": "isValid(datum.current_function)"},
    {
      "calculate": "datum.current_function === 'Government, Courts & Public Offices' ? 'Government & Civic' : datum.current_function === 'Education & Research' ? 'Education & Social' : datum.current_function === 'Places of Worship & Community' ? 'Worship & Community' : datum.current_function === 'Transport & Public Infrastructure' ? 'Transport & Infrastructure' : datum.current_function === 'Commerce, Hospitality & Tourism' ? 'Commerce & Retail' : datum.current_function",
      "as": "category_label"
    },
    {
      "aggregate": [{"op": "count", "as": "building_count"}],
      "groupby": ["category_label"]
    }
  ],
  "encoding": {
    "y": {
      "field": "category_label",
      "type": "nominal",
      "sort": {"field": "building_count", "order": "descending"},
      "title": null,
      "axis": {"labelFontSize": 12, "labelLimit": 320, "domain": false, "ticks": false}
    },
    "x": {
      "field": "building_count",
      "type": "quantitative",
      "title": "Number of Buildings",
      "scale": {"domain": [0, 13]},
      "axis": {
        "values": [0, 2, 4, 6, 8, 10, 12],
        "grid": true,
        "gridDash": [2, 3]
      }
    },
    "color": {
      "field": "category_label",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Government & Civic",
          "Education & Social",
          "Worship & Community",
          "Recreation, Sports & Memorials",
          "Commerce & Retail",
          "Transport & Infrastructure",
          "Museums, Culture & Libraries"
        ],
        "range": ["#8B4513", "#3A6EA5", "#2E8B57", "#D1495B", "#C9822B", "#7A5195", "#6A5ACD"]
      }
    },
    "tooltip": [
      {"field": "category_label", "type": "nominal", "title": "Category"},
      {"field": "building_count", "type": "quantitative", "title": "Buildings"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3},
      "encoding": {
        "x": {"datum": 0},
        "x2": {"field": "building_count"}
      }
    },
    {
      "mark": {"type": "circle", "size": 450, "opacity": 1, "stroke": "#ffffff", "strokeWidth": 2}
    },
    {
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "building_count", "type": "quantitative"},
        "color": {"value": "#ffffff"}
      }
    }
  ]
}