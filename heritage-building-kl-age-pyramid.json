{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "usermeta": {
    "dataSource": {
      "title": "Kuala Lumpur Heritage Buildings List",
      "url": "https://ppkl.dbkl.gov.my/wp-content/uploads/2025/06/1.-VOLUME-1-PART-1_DEVELOPMENT-CONTROL_.pdf",
      "page": "B1-61"
    }
  },
  "title": {
    "text": "Construction Decades of Kuala Lumpur Heritage Buildings",
    "subtitle": "Distribution of heritage structures across 10-year construction-year brackets by historical era",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 15
  },
  "width": "container",
  "height": 450,
  "background": "#fafafa",
  "data": {
    "url": "data-basic.json?dashboard-restructure=v1",
    "format": {"type": "json"}
  },
  "transform": [
    {"filter": "isValid(datum.start_year) && datum.start_year > 0"},
    {"calculate": "floor(datum.start_year / 10) * 10", "as": "year_bin_floor"},
    {"calculate": "datum.year_bin_floor + '–' + (datum.year_bin_floor + 9)", "as": "year_group"},
    {"calculate": "datum.start_year < 1957 ? 'Colonial Era (Pre-1957)' : 'Post-Independence (1957+)'", "as": "era_label"},
    {"calculate": "datum.start_year < 1957 ? -1 : 1", "as": "dir"},
    {
      "aggregate": [{"op": "count", "as": "building_count"}],
      "groupby": ["year_bin_floor", "year_group", "era_label", "dir"]
    },
    {"calculate": "datum.building_count * datum.dir", "as": "signed_count"}
  ],
  "layer": [
    {
      "mark": {"type": "bar", "stroke": "#ffffff", "strokeWidth": 1},
      "encoding": {
        "y": {
          "field": "year_bin_floor",
          "type": "ordinal",
          "sort": "ascending",
          "scale": {"domain": [1860, 1870, 1880, 1890, 1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990]},
          "title": "Construction Year",
          "axis": {
            "labelExpr": "datum.value + '–' + (datum.value + 9)",
            "labelFontSize": 12,
            "titleFontSize": 15,
            "titleFontWeight": "bold",
            "titlePadding": 18
          }
        },
        "x": {
          "field": "signed_count",
          "type": "quantitative",
          "title": "← Colonial Era (Count) | Post-Independence (Count) →",
          "axis": {
            "labelExpr": "abs(datum.value)",
            "tickCount": 7,
            "labelFontSize": 12,
            "titleFontSize": 15,
            "titleFontWeight": "bold",
            "titlePadding": 18
          }
        },
        "color": {
          "field": "era_label",
          "type": "nominal",
          "scale": {
            "domain": ["Colonial Era (Pre-1957)", "Post-Independence (1957+)"],
            "range": ["#8B4513", "#2E8B57"]
          },
          "legend": {"title": "Historical Era", "orient": "bottom"}
        },
        "tooltip": [
          {"field": "year_group", "type": "nominal", "title": "Construction Years"},
          {"field": "era_label", "type": "nominal", "title": "Historical Era"},
          {"field": "building_count", "type": "quantitative", "title": "Building Count"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {"expr": "datum.signed_count < 0 ? 'right' : 'left'"},
        "dx": {"expr": "datum.signed_count < 0 ? -5 : 5"},
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {"field": "year_bin_floor", "type": "ordinal", "sort": "ascending"},
        "x": {"field": "signed_count", "type": "quantitative"},
        "text": {"field": "building_count", "type": "quantitative"},
        "color": {"value": "#333333"}
      }
    },
    {
      "data": {"values": [{"x": 0}]},
      "mark": {"type": "rule", "color": "#666666", "strokeWidth": 1.5, "strokeDash": [4, 4]},
      "encoding": {"x": {"field": "x", "type": "quantitative"}}
    }
  ]
}