{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 320,
  "background": "#fafafa",
  "data": {
    "url": "data-basic.json?dashboard-restructure=v1",
    "format": {"type": "json"}
  },
  "transform": [
    {"filter": "isValid(datum.purpose)"},
    {
      "calculate": "datum.purpose === 'Civic, Government & Administrative' ? 'Government & Civic' : datum.purpose === 'Education & Social Clubs' ? 'Education & Social' : datum.purpose === 'Places of Worship & Religious Institutions' ? 'Worship & Community' : datum.purpose === 'Transportation & Public Infrastructure' ? 'Transport & Infrastructure' : datum.purpose === 'Commerce, Finance & Retail' ? 'Commerce & Retail' : datum.purpose",
      "as": "category_label"
    },
    {
      "aggregate": [{"op": "count", "as": "building_count"}],
      "groupby": ["category_label"]
    }
  ],
  "encoding": {
    "y": {
      "field": "category_label",
      "type": "nominal",
      "sort": {"field": "building_count", "order": "descending"},
      "title": null,
      "axis": {"labelFontSize": 12, "labelLimit": 320, "domain": false, "ticks": false}
    },
    "x": {
      "field": "building_count",
      "type": "quantitative",
      "title": "Number of Buildings",
      "scale": {"domain": [0, 22]},
      "axis": {"tickMinStep": 1, "grid": true, "gridDash": [2, 3]}
    },
    "color": {
      "field": "category_label",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Government & Civic",
          "Education & Social",
          "Residential & Royal",
          "Worship & Community",
          "Transport & Infrastructure",
          "Commerce & Retail"
        ],
        "range": ["#8B4513", "#3A6EA5", "#B5651D", "#2E8B57", "#7A5195", "#C9822B"]
      }
    },
    "tooltip": [
      {"field": "category_label", "type": "nominal", "title": "Category"},
      {"field": "building_count", "type": "quantitative", "title": "Buildings"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3},
      "encoding": {
        "x": {"datum": 0},
        "x2": {"field": "building_count"}
      }
    },
    {
      "mark": {"type": "circle", "size": 450, "opacity": 1, "stroke": "#ffffff", "strokeWidth": 2}
    },
    {
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "building_count", "type": "quantitative"},
        "color": {"value": "#ffffff"}
      }
    }
  ]
}